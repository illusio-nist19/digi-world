# Backend env (EasyPanel runtime)
# Copy to backend/.env.example
# NEVER commit a real .env or DATABASE password.

APP_ENV=production
APP_VERSION=1.0.0

# EasyPanel internal, database name digi-world. Example shape:
# postgres://postgres:PASSWORD@digi-world_digi-world-database:5432/digi-world?sslmode=disable
DATABASE_URL=postgres://postgres:CHANGE_ME@digi-world_digi-world-database:5432/digi-world?sslmode=disable

FRONTEND_ORIGINS=https://digi-world.online,https://www.digi-world.online

CHECKOUT_MODE=lead
DELIVERY_MODE=manual
PROOF_MODE=studio

SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Meta CAPI
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Snap CAPI v3
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
SNAP_TEST_MODE=false

CAPI_REQUIRE_CONSENT=false

RESEND_API_KEY=
RESEND_FROM=Digi World <hello@digi-world.online>

ADMIN_TOKEN=

# Rate limit
CHECKOUT_RATE_PER_MIN=10
