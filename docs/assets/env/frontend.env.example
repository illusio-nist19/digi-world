# Frontend env (EasyPanel build + runtime)
# Copy to frontend/.env.example  — Next.js inlines NEXT_PUBLIC_* at BUILD time.

NEXT_PUBLIC_SITE_URL=https://digi-world.online
NEXT_PUBLIC_API_URL=https://api.digi-world.online
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=hello@digi-world.online

# Web pixels (no secrets). Leave empty to disable a platform.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# Optional display
NEXT_PUBLIC_SAR_PER_USD=3.75
NEXT_PUBLIC_PROOF_MODE=studio

# Comma-separated extra origins if you test on a preview domain
# (backend CORS is the source of truth)
