# Backend env (EasyPanel runtime)
# NEVER commit a real .env or DATABASE password.

APP_ENV=production
APP_VERSION=1.0.0

# EasyPanel internal, database name digi-world. Example shape:
# postgres://postgres:PASSWORD@digi-world_digi-world-database:5432/digi-world?sslmode=disable
DATABASE_URL=postgres://postgres:CHANGE_ME@digi-world_digi-world-database:5432/digi-world?sslmode=disable

FRONTEND_ORIGINS=https://digi-world.online,https://www.digi-world.online,http://localhost:3000,http://localhost:3002

CHECKOUT_MODE=lead
DELIVERY_MODE=instant
STORE_URL=https://digi-world.online

# Stripe Checkout (required to take payment before the zip)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PROOF_MODE=studio

SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Meta CAPI
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Snap CAPI v3
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
SNAP_TEST_MODE=false

CAPI_REQUIRE_CONSENT=false

RESEND_API_KEY=
RESEND_FROM=Digi World <hello@digi-world.online>

ADMIN_TOKEN=

CHECKOUT_RATE_PER_MIN=10

# Social announce (Facebook Page + Instagram Professional + TikTok Content Posting).
# Pixel / CAPI tokens above cannot publish posts. Use a Page token and a TikTok creator token.
# After tokens are set, SOCIAL_AUTO_ANNOUNCE=true posts when a *new* SKU is seeded (max 3 at once).
# Manual: https://digi-world.online/en/ops/social  (header Authorization: Bearer ADMIN_TOKEN)
SOCIAL_AUTO_ANNOUNCE=false
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
TIKTOK_PUBLISH_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Login Kit (Sandbox client key/secret for first review video)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://digi-world.online/en/ops/social
